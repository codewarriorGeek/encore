# LLM provider: qwen (default) or claude
LLM_PROVIDER=qwen

# Qwen on Hetzner Inference (OpenAI-compatible)
HETZNER_API_KEY=
LLM_BASE_URL=https://inference.hetzner.com/api/v1
LLM_MODEL=Qwen/Qwen3.6-35B-A3B

# Claude
ANTHROPIC_API_KEY=

# Qloo hackathon API (key from the event email; never commit it)
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_TRUSTED_BASE_URL=https://hackathon.api.qloo.com
